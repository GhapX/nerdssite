{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/noticias/(.*)", "destination": "/" },
    { "source": "/vagas/(.*)", "destination": "/" },
    { "source": "/projetos/(.*)", "destination": "/" },
    { "source": "/ex-integrantes", "destination": "/" },
    { "source": "/ex-integrantes/", "destination": "/" },
    { "source": "/galeria", "destination": "/" },
    { "source": "/galeria/", "destination": "/" }
  ]
}